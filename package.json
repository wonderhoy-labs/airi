{
	"name": "airi",
	"private": true,
	"type": "module",
	"license": "Apache-2.0",
	"packageManager": "pnpm@12.15.0",
	"engines": {
		"node": ">=24"
	},
	"wonderhoy": {
		"name": "Airi",
		"tagline": "Linux apps on your Android launcher.",
		"character": "Momoi Airi",
		"unit": "MORE MORE JUMP!",
		"color": "#FFAACC"
	},
	"scripts": {
		"lint": "biome ci",
		"format": "biome check --write",
		"typecheck": "tsc -p .",
		"theme": "node tools/theme.ts",
		"unify": "node tools/unify.ts",
		"agent": "node tools/build-agent.ts",
		"licenses": "node tools/third-party-licenses.ts",
		"verify": "node tools/third-party-licenses.ts --check"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.3",
		"@material/material-color-utilities": "0.3.0",
		"@types/node": "26.6.6",
		"typescript": "7.0.2"
	}
}
